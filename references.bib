@article{gilyen_improved_2022,
	title = {An improved quantum-inspired algorithm for linear regression},
	volume = {6},
	issn = {2521-327X},
	url = {http://arxiv.org/abs/2009.07268},
	doi = {10.22331/q-2022-06-30-754},
	abstract = {We give a classical algorithm for linear regression analogous to the quantum matrix inversion algorithm [Harrow, Hassidim, and Lloyd, Physical Review Letters'09, arXiv:0811.3171] for low-rank matrices [Wossnig, Zhao, and Prakash, Physical Review Letters'18, arXiv:1704.06174], when the input matrix \$A\$ is stored in a data structure applicable for QRAM-based state preparation. Namely, suppose we are given an \$A {\textbackslash}in {\textbackslash}mathbb\{C\}{\textasciicircum}\{m{\textbackslash}times n\}\$ with minimum non-zero singular value \${\textbackslash}sigma\$ which supports certain efficient \${\textbackslash}ell\_2\$-norm importance sampling queries, along with a \$b {\textbackslash}in {\textbackslash}mathbb\{C\}{\textasciicircum}m\$. Then, for some \$x {\textbackslash}in {\textbackslash}mathbb\{C\}{\textasciicircum}n\$ satisfying \${\textbackslash}{\textbar}x - A{\textasciicircum}+b{\textbackslash}{\textbar} {\textbackslash}leq {\textbackslash}varepsilon{\textbackslash}{\textbar}A{\textasciicircum}+b{\textbackslash}{\textbar}\$, we can output a measurement of \${\textbar}x{\textbackslash}rangle\$ in the computational basis and output an entry of \$x\$ with classical algorithms that run in \${\textbackslash}tilde\{{\textbackslash}mathcal\{O\}\}{\textbackslash}big({\textbackslash}frac\{{\textbackslash}{\textbar}A{\textbackslash}{\textbar}\_\{{\textbackslash}mathrm\{F\}\}{\textasciicircum}6{\textbackslash}{\textbar}A{\textbackslash}{\textbar}{\textasciicircum}6\}\{{\textbackslash}sigma{\textasciicircum}\{12\}{\textbackslash}varepsilon{\textasciicircum}4\}{\textbackslash}big)\$ and \${\textbackslash}tilde\{{\textbackslash}mathcal\{O\}\}{\textbackslash}big({\textbackslash}frac\{{\textbackslash}{\textbar}A{\textbackslash}{\textbar}\_\{{\textbackslash}mathrm\{F\}\}{\textasciicircum}6{\textbackslash}{\textbar}A{\textbackslash}{\textbar}{\textasciicircum}2\}\{{\textbackslash}sigma{\textasciicircum}8{\textbackslash}varepsilon{\textasciicircum}4\}{\textbackslash}big)\$ time, respectively. This improves on previous "quantum-inspired" algorithms in this line of research by at least a factor of \${\textbackslash}frac\{{\textbackslash}{\textbar}A{\textbackslash}{\textbar}{\textasciicircum}\{16\}\}\{{\textbackslash}sigma{\textasciicircum}\{16\}{\textbackslash}varepsilon{\textasciicircum}2\}\$ [Chia, Gily{\textbackslash}'en, Li, Lin, Tang, and Wang, STOC'20, arXiv:1910.06151]. As a consequence, we show that quantum computers can achieve at most a factor-of-12 speedup for linear regression in this QRAM data structure setting and related settings. Our work applies techniques from sketching algorithms and optimization to the quantum-inspired literature. Unlike earlier works, this is a promising avenue that could lead to feasible implementations of classical regression in a quantum-inspired settings, for comparison against future quantum computers.},
	urldate = {2023-12-03},
	journal = {Quantum},
	author = {Gilyén, András and Song, Zhao and Tang, Ewin},
	month = jun,
	year = {2022},
	note = {arXiv:2009.07268 [quant-ph]},
	keywords = {Computer Science - Data Structures and Algorithms, Quantum Physics},
	pages = {754},
}

